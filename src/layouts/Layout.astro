---
import Header from '../components/const/header.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  canonical?: string;
  ogImage?: string;
}

const {
	title = 'Come Game Guide: App Download, Bonus and Safety',
	description = 'Come Game Guide is an informational site for Indian users covering app download steps, bonuses, payment basics, risks, and responsible gaming tips.',
  keywords = '',
  canonical = 'https://www.comegameapp.com/',
	ogImage = 'https://www.comegameapp.com/android-chrome-512x512.png',
} = Astro.props as Props;

const siteName = 'Come Game Guide';
const primaryDomain = 'https://www.comegameapp.com';
const canonicalUrl = new URL(canonical, primaryDomain)
	.toString()
	.replace(/^https:\/\/comegameapp\.com/, primaryDomain);

const organizationSchema = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	name: siteName,
	url: primaryDomain,
	logo: 'https://www.comegameapp.com/android-chrome-512x512.png',
	email: 'contact@comegameapp.com',
	description:
		'Independent informational website for Indian users covering Come Game app download, safety, payments, and responsible gaming guidance.',
};

const webPageSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebPage',
	name: title,
	url: canonicalUrl,
	description,
	inLanguage: 'en-IN',
	isPartOf: {
		'@type': 'WebSite',
		name: siteName,
		url: primaryDomain,
	},
};
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		{keywords && <meta name="keywords" content={keywords} />}
		<meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
		<meta name="googlebot" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
		<meta name="author" content={siteName} />
		<meta name="theme-color" content="#0f172a" />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="alternate" hreflang="en-in" href={canonicalUrl} />
		<link rel="alternate" hreflang="x-default" href={canonicalUrl} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:locale" content="en_IN" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)}></script>
		<script type="application/ld+json" set:html={JSON.stringify(webPageSchema)}></script>

		<slot name="head" />
	</head>
	<body>
		<Header />
		<main id="main-content">
			<slot />
		</main>
		<footer class="border-t border-border/70 bg-card/50">
			<div class="container mx-auto px-4 py-10">
				<div class="grid gap-8 md:grid-cols-3">
					<div>
						<h2 class="text-lg font-extrabold text-foreground">Come Game Guide</h2>
						<p class="mt-3 text-sm leading-6 text-muted-foreground">
							Independent informational website for app guidance, safety, and responsible gaming resources.
						</p>
					</div>

					<div>
						<h3 class="text-sm font-bold uppercase tracking-wide text-foreground">Important Pages</h3>
						<ul class="mt-3 space-y-2 text-sm text-muted-foreground">
							<li><a href="/" class="hover:text-foreground hover:underline">Home</a></li>
							<li><a href="/come-games" class="hover:text-foreground hover:underline">Come Games</a></li>
							<li><a href="/download-come-games-app" class="hover:text-foreground hover:underline">Download Guide</a></li>
							<li><a href="/real-money-come-games" class="hover:text-foreground hover:underline">Real Money Guide</a></li>
							<li><a href="/responsible-gaming" class="hover:text-foreground hover:underline">Responsible Gaming</a></li>
							<li><a href="/faq" class="hover:text-foreground hover:underline">FAQ</a></li>
							<li><a href="/contact" class="hover:text-foreground hover:underline">Contact</a></li>
						</ul>
					</div>

					<div>
						<h3 class="text-sm font-bold uppercase tracking-wide text-foreground">Company & Legal</h3>
						<ul class="mt-3 space-y-2 text-sm text-muted-foreground">
							<li><a href="/about" class="hover:text-foreground hover:underline">About</a></li>
							<li><a href="/privacy-policy" class="hover:text-foreground hover:underline">Privacy Policy</a></li>
							<li><a href="/terms-and-conditions" class="hover:text-foreground hover:underline">Terms & Conditions</a></li>
							<li><a href="/disclaimer" class="hover:text-foreground hover:underline">Disclaimer</a></li>
						</ul>
					</div>
				</div>
			</div>
		</footer>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
	}
</style>
