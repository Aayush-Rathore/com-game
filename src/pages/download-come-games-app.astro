      <ul class="mt-4 list-disc space-y-2 pl-6 text-base leading-7 text-muted-foreground">
        <li>Welcome bonus offers</li>
        <li>Cashback or deposit rewards</li>
        <li>Daily reward events</li>
        <li>Jackpot promotions</li>
