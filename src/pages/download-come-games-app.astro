        <li>People seeking guaranteed income</li>
        <li>Users facing financial stress</li>
        <li>Individuals with gambling addiction concerns</li>
      </ul>
    </section>

    <section class="mt-12 max-w-4xl rounded-xl border border-destructive/40 bg-destructive/10 p-5">
      <h2 class="text-2xl font-extrabold tracking-tight text-foreground md:text-3xl">Responsible Gaming Notice</h2>
      <p class="mt-4 text-base leading-7 text-foreground">
