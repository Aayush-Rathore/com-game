				<ul class="mt-3 flex flex-wrap gap-2">
					{keywords.slice(0, 40).map((term) => (
						<li class="rounded-full border border-border px-3 py-1 text-xs text-muted-foreground">{term}</li>
					))}
				</ul>
			</div>
		</div>
	</footer>
</Layout>
