			},
		},
		{
			'@type': 'Question',
			name: 'Can I use Comegame on mobile?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: 'Yes. Comegame is fully mobile-friendly and works smoothly on most Android and iOS devices.',
			},
		},
		{
			'@type': 'Question',
			name: 'Is real money involved on Comegame?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: 'Some features involve real money. Always read the platform terms and check local laws before participating in any paid gameplay.',
			},
		},
	],
};
---

<Layout
