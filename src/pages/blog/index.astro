---
import Layout from '../../layouts/Layout.astro';
import { PUBLIC_SITE_URL } from 'astro:env/client';

const seoTitle = 'Come Game Blog: Guides, Tutorials, and Beginner Tips';
const seoDescription =
	'Read the latest Come Game blog posts with beginner-friendly tutorials, gameplay basics, and platform feature explainers.';
const canonicalUrl = `${PUBLIC_SITE_URL}/blog`;
const ogImage = `${PUBLIC_SITE_URL}/android-chrome-512x512.png`;
const keywordsMeta =
	'comegame blog, comegame tutorial, how comegame works, comegame guides, comegame tips, online gaming india, comegame features, comegame skill games, comegame withdrawal, comegame bonus';

const posts = [
	{
		title: 'Best Dream11 Alternatives in India: Top Gaming Apps',
		description:
			'Explore the best Dream11 alternatives in India including Comegame and other platforms. Compare features, usability, and choose what fits your style.',
		url: '/blog/best-dream11-alternatives-india-comegame',
		published: 'March 24, 2026',
		category: 'Comparison Guide',
		readTime: '10 min read',
	},
	{
		title: 'Comegame vs Other Online Gaming Platforms: Differences',
		description:
			'Compare Comegame with other online gaming platforms and understand differences in usability, features, performance, and audience fit.',
		url: '/blog/comegame-vs-other-online-gaming-platforms',
		published: 'March 24, 2026',
		category: 'Comparison Guide',
		readTime: '9 min read',
	},
	{
		title: 'How Online Gaming Platforms Like Comegame Operate',
		description:
			'Understand how online gaming platforms work behind the scenes, including servers, system design, data management, and real-time gameplay.',
		url: '/blog/how-online-gaming-platforms-like-comegame-operate',
		published: 'March 24, 2026',
		category: 'Platform Guide',
		readTime: '8 min read',
	},
	{
		title: 'Top Tips to Improve Your Performance on Comegame',
		description:
			'Learn practical tips to improve your Comegame performance, avoid common mistakes, and build a consistent strategy with better decision-making.',
		url: '/blog/improve-performance-on-comegame-tips-guide',
		published: 'March 24, 2026',
		category: 'Tips & Strategy',
		readTime: '7 min read',
	},
	{
		title: 'How Comegame Works - Features, Gameplay & Basics',
		description:
			'Learn how Comegame works with practical basics, key features, gameplay flow, and beginner-friendly tips in one complete guide.',
		url: '/blog/how-comegame-works-features-gameplay-basics',
		published: 'March 24, 2026',
		category: 'Beginner Guide',
		readTime: '9 min read',
	},
	{
		title: 'Comegame Bonus Guide India: Welcome Offers & Wagering Explained',
		description:
			'A complete guide to Comegame bonuses in India — welcome offers, referral rewards, deposit matches, wagering requirements, and how to evaluate every promotion.',
		url: '/blog/comegame-bonus-guide-india',
		published: 'July 1, 2026',
		category: 'Bonus Guide',
		readTime: '14 min read',
	},
	{
		title: 'Comegame Withdrawal Guide: How to Cash Out Safely in India',
		description:
			'Step-by-step guide to withdrawing winnings on Comegame — UPI cashouts, KYC requirements, timelines, common problems, and TDS for Indian users.',
		url: '/blog/comegame-withdrawal-guide',
		published: 'July 1, 2026',
		category: 'Payments Guide',
		readTime: '13 min read',
	},
	{
		title: 'Comegame Account Setup Guide: Registration, KYC & Security',
		description:
			'Complete Comegame account setup guide — step-by-step registration, KYC document requirements, 2FA security, UPI linking, and common error fixes for Indian users.',
		url: '/blog/comegame-account-setup-guide',
		published: 'July 1, 2026',
		category: 'Account Guide',
		readTime: '15 min read',
	},
	{
		title: 'Comegame Skill Games Explained: Types, Rules & Winning Tips',
		description:
			'Everything you need to know about skill games on Comegame — game types, Indian legal framework, how scoring works, and practical strategies to win more often.',
		url: '/blog/comegame-skill-games-explained',
		published: 'July 1, 2026',
		category: 'Skill Games Guide',
		readTime: '16 min read',
	},
];
---

<Layout
	title={seoTitle}
	description={seoDescription}
	keywords={keywordsMeta}
	canonical={canonicalUrl}
	ogImage={ogImage}
>
	<section class="border-b border-border/70 bg-[radial-gradient(circle_at_top_right,hsl(var(--primary)/0.15),transparent_42%),radial-gradient(circle_at_10%_10%,hsl(var(--accent)/0.5),transparent_35%)]">
		<div class="container mx-auto px-4 py-16 md:py-20">
			<p class="inline-flex rounded-full border border-primary/40 bg-primary/10 px-3 py-1 text-xs font-bold uppercase tracking-wide text-primary">
				Come Game Blog
			</p>
			<h1 class="mt-4 max-w-4xl text-3xl font-black tracking-tight text-foreground md:text-5xl">
				Come Game Blog: Practical Guides for New and Returning Users
			</h1>
			<p class="mt-5 max-w-3xl text-base leading-7 text-muted-foreground md:text-lg">
				This blog section includes detailed explainers about platform basics, feature walkthroughs, and
				beginner tips so readers can learn step by step before using any gaming app.
			</p>
		</div>
	</section>

	<section class="container mx-auto px-4 py-14">
		<h2 class="text-2xl font-extrabold tracking-tight text-foreground md:text-3xl">Latest Articles</h2>
		<div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
			{
				posts.map((post) => (
					<article class="group rounded-2xl border border-border bg-card p-6 transition hover:-translate-y-1 hover:border-primary/40">
						<div class="flex flex-wrap items-center gap-2 text-xs font-semibold text-muted-foreground">
							<span class="rounded-full border border-border bg-background px-2.5 py-1">{post.category}</span>
							<span>{post.published}</span>
							<span>{post.readTime}</span>
						</div>
						<h3 class="mt-4 text-xl font-black tracking-tight text-foreground">{post.title}</h3>
						<p class="mt-3 text-sm leading-7 text-muted-foreground">{post.description}</p>
						<a
							href={post.url}
							class="mt-5 inline-flex items-center text-sm font-bold text-primary underline-offset-4 group-hover:underline"
						>
							Read full article
						</a>
					</article>
				))
			}
		</div>
	</section>
</Layout>
