---
import Layout from '../layouts/Layout.astro';
import contentData from '../assets/content.json';
import { PUBLIC_SITE_URL } from 'astro:env/client';

const keywordsMeta = contentData.keywords.slice(0, 80).join(', ');

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Disclaimer – Come Game Guide",
  "description": "Disclaimer explaining limitations of liability and affiliate relationships on Come Game Guide.",
  "url": `${PUBLIC_SITE_URL}/disclaimer`,
  "publisher": {
    "@type": "Organization",
    "name": "Come Game Guide",
    "url": PUBLIC_SITE_URL
  }
};
---

<Layout
  title="Disclaimer – Come Game Guide"
  description="Disclaimer explaining the limitations of liability and affiliate relationships on Come Game Guide."
  keywords={keywordsMeta}
  canonical={`${PUBLIC_SITE_URL}/disclaimer`}
  ogImage={`${PUBLIC_SITE_URL}/android-chrome-512x512.png`}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)}></script>
  </Fragment>

  <main class="max-w-3xl mx-auto px-4 py-12 text-gray-800">

    <h1 class="text-3xl font-bold text-gray-900 mb-2">Disclaimer</h1>
    <p class="text-sm text-gray-500 mb-8">Last updated: January 2026</p>

    <p class="mb-4">
      The information provided on <strong>Come Game Guide</strong> is for general informational and
      educational purposes only. By using this website, you agree to the terms outlined in this disclaimer.
    </p>
    <p class="mb-4">
      Come Game Guide is an <strong>independent informational website</strong> that provides guides
      related to the Come Game platform and similar real-money gaming topics.
    </p>
    <p class="mb-10">
      We do <strong>not operate gaming platforms</strong>, hold player funds, or manage user accounts.
    </p>

    <hr class="border-gray-200 mb-10" />

    <!-- No Affiliation -->
    <section class="mb-10" aria-labelledby="no-affiliation">
      <h2 id="no-affiliation" class="text-2xl font-semibold text-gray-900 mb-4">No Affiliation with Come Game</h2>
      <p class="mb-4">
        Come Game Guide is <strong>not affiliated with, owned by, or operated by the official Come Game platform</strong>.
      </p>
      <p class="mb-4 text-gray-700">
        All trademarks, brand names, and logos mentioned on this website belong to their respective owners.
      </p>
      <p class="text-gray-700">
        Any references to the Come Game platform are used only for informational purposes.
      </p>
    </section>

    <!-- Informational Content Only -->
    <section class="mb-10" aria-labelledby="info-only">
      <h2 id="info-only" class="text-2xl font-semibold text-gray-900 mb-4">Informational Content Only</h2>
      <p class="mb-4">
        The content published on this website is intended to provide general information about the
        Come Game platform and real-money gaming topics. We do not provide:
      </p>
      <ul class="list-disc list-inside space-y-2 text-gray-700 mb-4">
        <li>Financial advice</li>
        <li>Legal advice</li>
        <li>Betting strategies</li>
        <li>Guarantees of profit</li>
      </ul>
      <p class="text-gray-700">
        Users should always conduct their own research before participating in any gaming platform.
      </p>
    </section>

    <!-- Affiliate Disclosure -->
    <section class="mb-10" aria-labelledby="affiliate">
      <h2 id="affiliate" class="text-2xl font-semibold text-gray-900 mb-4">Affiliate Disclosure</h2>
      <p class="mb-4">
        Some links on this website may be affiliate links. If users click on these links and register
        on third-party platforms, we may receive a commission at <strong>no additional cost to the user</strong>.
      </p>
      <p class="text-gray-700">
        Affiliate partnerships help support the operation of this website but <strong>do not influence
        our editorial content</strong>.
      </p>
    </section>

    <!-- No Responsibility for External Platforms -->
    <section class="mb-10" aria-labelledby="external-platforms">
      <h2 id="external-platforms" class="text-2xl font-semibold text-gray-900 mb-4">No Responsibility for External Platforms</h2>
      <p class="mb-4">
        Come Game Guide does not control or operate any external gaming platform.
        We are not responsible for:
      </p>
      <ul class="list-disc list-inside space-y-2 text-gray-700 mb-4">
        <li>Account issues</li>
        <li>Deposits or withdrawals</li>
        <li>Bonuses or promotions</li>
        <li>Gameplay results</li>
        <li>Financial losses</li>
      </ul>
      <p class="text-gray-700">
        Users should contact the official platform directly for support related to their accounts.
      </p>
    </section>

    <!-- Real Money Gaming Risk -->
    <section class="mb-10 bg-yellow-50 border border-yellow-200 rounded-lg p-6" aria-labelledby="gaming-risk">
      <h2 id="gaming-risk" class="text-2xl font-semibold text-gray-900 mb-4">Real Money Gaming Risk</h2>
      <p class="mb-4 text-gray-700">
        Real-money gaming involves financial risk and may be addictive. Important reminders:
      </p>
      <ul class="list-disc list-inside space-y-2 text-gray-700 mb-4">
        <li>Only play if you are <strong>18 years or older</strong></li>
        <li>Never play with money you cannot afford to lose</li>
        <li>Gaming should be treated as entertainment</li>
      </ul>
      <p class="mb-4 text-gray-700">
        Users are responsible for understanding the laws and regulations that apply in their region.
      </p>
      <p>
        <a href="/responsible-gaming" class="text-blue-600 hover:underline" aria-label="Read Come Game Guide responsible gaming tips">
          Read our Responsible Gaming guide →
        </a>
      </p>
    </section>

    <!-- Limitation of Liability -->
    <section class="mb-10" aria-labelledby="liability">
      <h2 id="liability" class="text-2xl font-semibold text-gray-900 mb-4">Limitation of Liability</h2>
      <p class="mb-4">
        Come Game Guide and its operators will not be liable for any:
      </p>
      <ul class="list-disc list-inside space-y-2 text-gray-700 mb-4">
        <li>Financial losses</li>
        <li>Damages</li>
        <li>Legal issues</li>
        <li>Disputes with third-party platforms</li>
      </ul>
      <p class="text-gray-700">
        that may occur as a result of using information on this website. All actions taken based on
        the information provided are done <strong>at the user's own risk</strong>.
      </p>
    </section>

    <!-- Changes -->
    <section class="mb-10" aria-labelledby="changes">
      <h2 id="changes" class="text-2xl font-semibold text-gray-900 mb-4">Changes to This Disclaimer</h2>
      <p class="text-gray-700">
        We may update this disclaimer from time to time. Any updates will be posted on this page
        with a revised date.
      </p>
    </section>

    <!-- Contact -->
    <section class="mb-10" aria-labelledby="contact">
      <h2 id="contact" class="text-2xl font-semibold text-gray-900 mb-4">Contact</h2>
      <p class="mb-4 text-gray-700">
        If you have any questions regarding this disclaimer, you can contact us:
      </p>
      <p class="mb-4">
        <strong>Email:</strong>
        <a
          href="mailto:contact@comegameapp.com"
          class="text-blue-600 hover:underline ml-1"
          aria-label="Email Come Game Guide at contact@comegameapp.com"
        >
          contact@comegameapp.com
        </a>
      </p>
      <p class="text-gray-700">
        You can also visit our
        <a href="/contact" class="text-blue-600 hover:underline" aria-label="Go to Come Game Guide contact page">Contact page</a>
        for more ways to reach us.
      </p>
    </section>

    <hr class="border-gray-200 mb-8" />

    <p class="text-sm text-gray-500 text-center">
      Come Game Guide is an independent informational website. We are not affiliated with any gaming operator.
      <a href="/about" class="text-blue-600 hover:underline ml-1" aria-label="Learn more about Come Game Guide">Learn about us</a>.
    </p>

  </main>
</Layout>
